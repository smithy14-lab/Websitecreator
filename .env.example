# ---- Required everywhere ----------------------------------------------------

# Anthropic API key for AI site + copy generation
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google Places API (New) key for finding businesses
# Get one at https://console.cloud.google.com (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Password to access the admin dashboard.
ADMIN_PASSWORD=change-me-too

# Public base URL of the deployed app, used for Stripe redirects + share links.
# Local dev: http://localhost:5000
# Production: https://yourdomain.com
BASE_URL=http://localhost:5000

# Subdomain hosting per customer (optional). When enabled, requests to
# <slug>.<APEX_DOMAIN> serve that customer's site directly. Requires a
# wildcard DNS record (*.yourdomain.com -> app IP) on your DNS host.
SUBDOMAIN_MODE=0
APEX_DOMAIN=

# ---- Production only --------------------------------------------------------

# Postgres connection string. Leave blank locally (falls back to SQLite).
# Railway/Render provide this automatically as DATABASE_URL.
DATABASE_URL=

# Stripe API keys + price IDs.
# Create products + prices in https://dashboard.stripe.com/products
# then paste their price_xxx IDs below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_CUSTOM_DOMAIN=
STRIPE_PRICE_ID_MULTIPAGE=
STRIPE_PRICE_ID_PREMIUM=
